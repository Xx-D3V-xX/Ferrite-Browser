# ── Ferrite — repo root .gitignore ──────────────────────────
# Single workspace root since the 2026-09 flatten (was split across
# repo-root + Browser/ + paper/). Cargo.lock is intentionally NOT
# ignored — this workspace ships a binary, so the lockfile is committed
# for reproducibility.

# ── Rust build output ────────────────────────────────────────
/target/
/corpus/*.db
/corpus/*.sqlite*

# ── LaTeX build artifacts (paper/, archived but still a live worktree) ──
paper/*.aux
paper/*.bbl
paper/*.blg
paper/*.fdb_latexmk
paper/*.fls
paper/*.log
paper/*.out
paper/*.synctex.gz
paper/*.toc
paper/*.lof
paper/*.lot
paper/*.loa
# Don't commit the compiled PDF — regenerate from source
paper/main.pdf

# ── Python cache ─────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo

# ── OS and editor files ──────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*~
.vscode/settings.json
.idea/

# ── Claude / AI tool artifacts ───────────────────────────────
.claude/
Resources/ferrite_viva_prep_guide.html
Executables/
staged/

# ── Local run state (scripts/setup-local.sh, scripts/run-local.sh) ────
# These live under $FERRITE_HOME, which defaults to <repo>/.ferrite, so a venv,
# a multi-GB checkpoint, a pid/log file or an env file with real values can
# never be staged by accident.
env.local
/.ferrite/
/.ferrite-home/
/.venv/
/laya-browser/
/laya/
serve.pid
serve.log
*.safetensors

# ── Secrets — never commit ───────────────────────────────────
gemini_key.txt
.env
.env.*
*.pem
*.key
